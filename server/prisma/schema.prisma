generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SessionStatus {
  DRAFT
  OPEN
  CLOSED
  GROUPED
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique @db.VarChar(190)
  name           String          @db.VarChar(120)
  passwordHash   String?         @db.VarChar(255)
  googleId       String?         @unique @db.VarChar(64)
  role           UserRole        @default(USER)
  status         UserStatus      @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessions       Session[]
  passwordResets PasswordReset[]
  logs           SystemLog[]
  traffic        TrafficEvent[]

  @@index([createdAt(sort: Desc)])
  @@index([role, status])
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  level     String   @db.VarChar(20)
  category  String   @db.VarChar(40)
  message   String   @db.VarChar(500)
  meta      Json?
  ip        String?  @db.VarChar(64)
  userId    Int?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([level, createdAt])
}

model TrafficEvent {
  id         Int      @id @default(autoincrement())
  method     String   @db.VarChar(10)
  path       String   @db.VarChar(255)
  status     Int
  durationMs Int
  ip         String?  @db.VarChar(64)
  userId     Int?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model Session {
  id                   Int              @id @default(autoincrement())
  ownerId              Int
  title                String           @db.VarChar(200)
  expectedStudentCount Int?
  publicToken          String           @unique @db.VarChar(64)
  status               SessionStatus    @default(DRAFT)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  owner                User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  roles                RoleDefinition[]
  students             Student[]
  groups               GeneratedGroup[]

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([status])
}

model RoleDefinition {
  id            Int           @id @default(autoincrement())
  sessionId     Int
  name          String        @db.VarChar(100)
  slotsPerGroup Int
  position      Int
  session       Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  students      Student[]
  members       GroupMember[]

  @@unique([sessionId, name])
  @@unique([sessionId, position])
  @@index([sessionId])
}

model Student {
  id         Int            @id @default(autoincrement())
  sessionId  Int
  roleId     Int
  name       String         @db.VarChar(150)
  createdAt  DateTime       @default(now())
  session    Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Restrict)
  membership GroupMember?

  @@unique([sessionId, name])
  @@index([sessionId, roleId])
  @@index([sessionId, createdAt])
  @@index([roleId])
}

model GeneratedGroup {
  id        Int           @id @default(autoincrement())
  sessionId Int
  name      String        @db.VarChar(100)
  position  Int
  createdAt DateTime      @default(now())
  session   Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  members   GroupMember[]

  @@unique([sessionId, position])
  @@index([sessionId])
}

model GroupMember {
  id        Int            @id @default(autoincrement())
  groupId   Int
  studentId Int            @unique
  roleId    Int
  group     GeneratedGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  role      RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@index([roleId])
}
